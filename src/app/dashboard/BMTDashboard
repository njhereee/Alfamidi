'use client'

import React, { useState, useEffect } from 'react'
import { motion } from 'framer-motion'
import { Search, MapPin, ClipboardList, LogOut, FileText, ChevronRight } from 'lucide-react'
import { useRouter } from 'next/navigation'
import NextImage from 'next/image'
// Sesuaikan import form FCPT Anda (misalnya jika ingin memanggil form di halaman ini juga)
// import FCPTFormView from './FCPTFormView'

export default function BMTDashboard({ nik, metadata }: { nik: string, metadata: any }) {
  const router = useRouter()
  const [stores, setStores] = useState<any[]>([])
  const [isLoading, setIsLoading] = useState(true)
  const [searchQuery, setSearchQuery] = useState('')
  
  // State untuk form FCPT (jika PIC klik "FCPT")
  const [selectedStore, setSelectedStore] = useState<any>(null)
  const [showFCPTForm, setShowFCPTForm] = useState(false)

  const fullName = metadata?.full_name || 'User BMT'

  // Fetch data toko yang menjadi kelolaan PIC ini
  useEffect(() => {
    const fetchMyStores = async () => {
      setIsLoading(true)
      try {
        const { createClient } = await import('@/utils/supabase/client')
        const supabase = createClient()
        
        const { data, error } = await supabase
          .from('stores')
          .select('*')
          .ilike('pic_name', `%${fullName}%`) // <--- FILTERNYA DI SINI
          
        if (error) throw error

        setStores(data || [])
      } catch (err: any) {
        console.error('Error fetching stores:', err.message)
        // Sebagai fallback visual jika tabel tidak ada / error, kita masukkan dummy
        // agar sesuai desain gambar saat Anda testing.
        setStores([
          { 
            id: 1, 
            kode: 'SC1M', 
            nama: 'MIDI SARIWANGI RAYA [SAWI]', 
            cabang: 'BEKASI', 
            pic_name: 'MAHMUD HIDAYAT',
            fcpt_progress: '0/1',
            status: 'Belum dicek'
          }
        ])
      } finally {
        setIsLoading(false)
      }
    }

    fetchMyStores()
  }, [fullName])

  const handleSignOut = async () => {
    const { createClient } = await import('@/utils/supabase/client')
    const supabase = createClient()
    await supabase.auth.signOut()
    router.push('/login')
  }

  // Jika form FCPT sedang aktif
  if (showFCPTForm && selectedStore) {
    // Return komponen form FCPT Anda (pastikan diimport)
    // return <FCPTFormView store={selectedStore} onBack={() => setShowFCPTForm(false)} />
    return (
      <div className="p-8 text-center bg-gray-50 h-screen flex flex-col justify-center">
         <h1 className="text-2xl font-bold mb-4">Membuka Form FCPT untuk {selectedStore.nama}...</h1>
         <button onClick={() => setShowFCPTForm(false)} className="mx-auto px-4 py-2 bg-blue-600 text-white rounded-lg">Kembali</button>
      </div>
    )
  }

  // Filter pencarian lokal
  const filteredStores = stores.filter(s => 
    (s.nama?.toLowerCase().includes(searchQuery.toLowerCase()) || 
     s.kode?.toLowerCase().includes(searchQuery.toLowerCase()))
  )

  return (
    <div className="min-h-screen bg-[#f4f7fb] font-sans">
      
      {/* Header */}
      <header className="bg-white border-b border-gray-200 px-6 md:px-12 py-5 flex justify-between items-center z-10 shadow-sm sticky top-0">
        <div className="flex items-center gap-4">
          <NextImage 
            src="/images/alfamidi-logo.png" // Sesuaikan path logo
            alt="Alfamidi" 
            width={100} 
            height={40} 
            className="object-contain hidden md:block"
          />
          <div className="h-8 w-px bg-gray-200 hidden md:block"></div>
          <div>
            <h1 className="text-xl md:text-2xl font-black text-gray-800 tracking-tight">Dashboard BMT</h1>
            <p className="text-sm text-gray-500 font-medium">Selamat bertugas, <span className="font-bold text-[#cc1e2c]">{fullName}</span></p>
          </div>
        </div>
        
        <button 
          onClick={handleSignOut} 
          className="flex items-center gap-2 px-4 py-2 bg-red-50 text-red-600 hover:bg-red-100 rounded-xl font-bold transition-colors"
        >
          <LogOut size={18} />
          <span className="hidden md:inline">Keluar</span>
        </button>
      </header>

      {/* Main Content */}
      <main className="max-w-6xl mx-auto p-6 md:p-8 space-y-6">
        
        <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <h2 className="text-lg font-bold text-gray-800">Toko Kelolaan Anda ({stores.length})</h2>
          
          <div className="relative w-full md:w-72">
            <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400" size={18} />
            <input 
              type="text" 
              placeholder="Cari kode atau nama toko..." 
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              className="w-full bg-white border border-gray-200 rounded-xl pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#cc1e2c] text-gray-800 shadow-sm"
            />
          </div>
        </div>

        {isLoading ? (
          <div className="flex flex-col items-center justify-center py-20">
            <div className="w-10 h-10 border-4 border-gray-200 border-t-[#cc1e2c] rounded-full animate-spin mb-4"></div>
            <p className="text-gray-500 font-medium">Memuat data toko...</p>
          </div>
        ) : filteredStores.length === 0 ? (
          <div className="bg-white border-2 border-dashed border-gray-200 rounded-2xl p-12 text-center">
            <MapPin size={48} className="mx-auto text-gray-300 mb-4" />
            <p className="text-gray-500 font-medium text-lg">Tidak ada toko yang ditemukan</p>
            <p className="text-gray-400 mt-1">Anda mungkin belum di-*assign* sebagai PIC di toko manapun.</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {filteredStores.map((store) => (
              
              // --- CARD TOKO (Sesuai Referensi Gambar) ---
              <motion.div 
                key={store.id} 
                initial={{ opacity: 0, y: 10 }}
                animate={{ opacity: 1, y: 0 }}
                className="bg-[#fafafa] rounded-[24px] border border-gray-200 overflow-hidden flex flex-col shadow-sm hover:shadow-md transition-shadow"
              >
                 <div className="p-6 flex-1 relative">
                   <div className="flex justify-between items-start mb-6">
                     <h3 className="text-2xl font-black text-[#1e293b]">{store.kode}</h3>
                     <span className="bg-white px-3 py-1 rounded-full text-[11px] font-bold text-gray-600 border border-gray-200 shadow-sm uppercase tracking-wide">
                       {store.cabang || 'BEKASI'}
                     </span>
                   </div>
                   
                   <div>
                     <h4 className="font-extrabold text-[#334155] text-lg leading-tight mb-1">{store.nama}</h4>
                     <p className="text-xs font-bold text-gray-400 uppercase tracking-wide">{store.pic_name}</p>
                   </div>
                 </div>

                 <div className="bg-[#fee2e2] px-6 py-4 border-t border-red-200 flex justify-between items-center">
                   <div className="flex items-center gap-2 text-[#b91c1c] font-black text-sm tracking-wide">
                     {/* Icon Checklist Simple */}
                     <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><path d="M16 3h5v5"/><path d="M8 3H3v5"/><path d="M12 22v-8"/><path d="m3 21 8-8"/><path d="m21 21-8-8"/></svg>
                     <span>FCPT</span>
                   </div>
                   
                   <div className="flex items-center gap-4">
                     <span className="text-[#dc2626] text-xs font-semibold">{store.status || 'Belum dicek'}</span>
                     <button 
                       onClick={() => { setSelectedStore(store); setShowFCPTForm(true); }}
                       className="bg-[#b91c1c] hover:bg-red-800 text-white text-sm font-black px-4 py-1.5 rounded-full transition-colors active:scale-95 shadow-sm flex items-center gap-1"
                     >
                       {store.fcpt_progress || '0/1'}
                       <ChevronRight size={14} className="ml-1" />
                     </button>
                   </div>
                 </div>
              </motion.div>
            ))}
          </div>
        )}
      </main>
    </div>
  )
}